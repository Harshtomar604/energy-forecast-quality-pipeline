# Copy to .env (never commit .env). Free key: https://console.groq.com/keys
LLM_API_KEY=
# Leave LLM_MODEL empty on the first run: the briefing status will list the models your key can use.
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Gemini instead: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
